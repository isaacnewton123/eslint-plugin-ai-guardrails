{
  "name": "eslint-plugin-ai-guardrails",
  "version": "1.3.1",
  "description": "ESLint rules to prevent AI-generated chaos: god files, god functions, orphan TODOs, and obvious comments.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "ai",
    "guardrails",
    "typescript"
  ],
  "homepage": "https://github.com/isaacnewton123/eslint-plugin-ai-guardrails#readme",
  "bugs": {
    "url": "https://github.com/isaacnewton123/eslint-plugin-ai-guardrails/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacnewton123/eslint-plugin-ai-guardrails.git"
  },
  "license": "MIT",
  "author": "Hanif Maulana (Isaac Newton) <https://github.com/isaacnewton123>",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-guardrails": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run lint && tsc -p tsconfig.json && node scripts/postbuild-cli.js",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "jest"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "eslint": "^8.0.0 || ^9.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.31.1",
    "@typescript-eslint/utils": "^8.31.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "vite": "^8.0.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
